# Copy to .env and fill in. Never commit the real .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nistguard?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
SESSION_SECRET=replace-with-a-long-random-string
PORT=5000
NODE_ENV=development

# Only needed if your local DNS resolver refuses SRV lookups (querySrv ECONNREFUSED).
# Leave unset in hosted environments.
# DNS_SERVERS=8.8.8.8,1.1.1.1
